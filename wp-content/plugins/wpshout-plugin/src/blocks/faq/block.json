{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "name": "wpshout/faq",
    "apiVersion": 3,
    "title": "FAQ Block",
    "description": "List of frequently asked questions and answers.",
    "category": "marketing",
    "editorScript": "file:./index.js",
    "style": "wpshout-faq-block",
    "allowedBlocks": [
        "wpshout/faq-item"
    ],
    "attributes": {
        "open": {
            "type": "boolean",
            "default": null
        }
    },
    "providesContext": {
        "wpshout/faq/open": "open"
    },
    "supports": {
        "color": {
            "background": true,
            "text": true,
            "link": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true,
            "textAlign": true,
            "__experimentalFontFamily": true,
            "__experimentalTextDecoration": true,
            "__experimentalFontStyle": true
        },
        "spacing": {
            "margin": true,
            "padding": true,
            "blockGap": true
        },
        "__experimentalBorder": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        }
    }
}